{
  "name": "hydra",
  "main": "cloudflare/hydra.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "containers": [
    {
      "class_name": "HydraContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HYDRA",
        "class_name": "HydraContainer"
      }
    ]
  },
  "exports": {
    "HydraContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
