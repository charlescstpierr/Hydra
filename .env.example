# --- Providers (au moins un requis) ---
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Modèles locaux compatibles OpenAI (Ollama, LM Studio, vLLM…) ---
LOCAL_BASE_URL=
LOCAL_API_KEY=
# liste séparée par des virgules: id[:label]
LOCAL_MODELS=

# --- Modèles ---
# id du modèle par défaut, ex: grok-4, claude-sonnet-4-5, gpt-5, gemini-2.5-pro
DEFAULT_MODEL=
# modèle utilisé pour les titres, résumés et extraction mémoire
UTILITY_MODEL=
TEMPERATURE=0.7
CONTEXT_WINDOW_MESSAGES=40
MEMORY_EXTRACTION=1

# --- Outils ---
# recherche web
TAVILY_API_KEY=
# génération d'images, ex: grok-2-image ou gpt-image-1
IMAGE_MODEL=

# --- Voix ---
# xAI si XAI_API_KEY est défini (voix custom/clonage), sinon OpenAI
SPEECH_VOICE=eve
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- Stockage ---
HYDRA_DB_PATH=./data/hydra.db
HYDRA_UPLOAD_DIR=./data/uploads
# ordinateur partagé des bots (fichiers + commandes après approbation)
HYDRA_WORKSPACE_DIR=./data/workspace
